{
  "name": "zentree",
  "version": "1.0.0",
  "description": "A lightweight Git GUI client built with Electron, React, and Canvas",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n main,renderer \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json && wait-on http://localhost:5173 && electron . --dev",
    "dev:renderer": "vite",
    "build": "tsc -p tsconfig.main.json && vite build",
    "pack": "npm run build && electron-builder --win --x64 --config.electronDist=node_modules/electron/dist --config.electronVersion=36.3.1",
    "pack:linux": "npm run build && electron-builder --linux --x64 --config.electronDist=node_modules/electron/dist --config.electronVersion=36.3.1",
    "pack:all": "npm run build && electron-builder --win --linux --x64 --config.electronDist=node_modules/electron/dist --config.electronVersion=36.3.1",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.zentree.app",
    "productName": "ZenTree",
    "copyright": "Copyright 2026",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZenTree"
    }
  },
  "dependencies": {
    "simple-git": "^3.27.0",
    "zustand": "^5.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "36.3.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wait-on": "^8.0.3"
  }
}
